# §7.3 — as três variáveis do servidor.
#
# Copie para `.env.local` (que está no .gitignore) para rodar localmente, e
# cadastre as mesmas na Vercel em Settings → Environment Variables, marcadas
# para Production e Preview (§16). Mudança nelas exige redeploy para valer.
#
# NUNCA prefixe nenhuma delas com NEXT_PUBLIC_. O Next embute no bundle tudo que
# começa assim, e a chave iria para o navegador de quem abrir a página.

RESEND_API_KEY=re_troque_isto
EMAIL_DESTINO=voce@sua-instituicao.com.br
# Precisa ser de um domínio verificado no Resend.
EMAIL_REMETENTE=ferramentas@seu-dominio.com.br
